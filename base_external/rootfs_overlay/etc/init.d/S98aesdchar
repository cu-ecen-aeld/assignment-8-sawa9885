#!/bin/sh

case "$1" in
	start)
		echo "Loading aesdchar"
		modprobe aesdchar || exit 1
		major="$(awk '$2 == "aesdchar" { print $1 }' /proc/devices)"
		if [ -z "${major}" ]; then
			echo "Unable to determine aesdchar major number" >&2
			rmmod aesdchar
			exit 1
		fi
		rm -f /dev/aesdchar
		mknod /dev/aesdchar c "${major}" 0 || exit 1
		chmod 0666 /dev/aesdchar
		;;
	stop)
		echo "Unloading aesdchar"
		rm -f /dev/aesdchar
		if grep -q '^aesdchar ' /proc/modules; then
			rmmod aesdchar
		fi
		;;
	restart)
		"$0" stop && "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
